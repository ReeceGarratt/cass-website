---
interface Props {
  id: string;
  term: string;
}

const { id, term } = Astro.props;
---

<button
  class="definition-trigger"
  type="button"
  popovertarget={id}
  popovertargetaction="show"
>
  {term}
</button>
<span class="definition-tip" id={id} popover>
  <span class="definition-tip__term type-subtitle">{term}</span>
  <span class="definition-tip__body type-subtitle">
    <slot />
  </span>
</span>

<style>
  .definition-trigger {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    /* D-042: the company name is Bold and underlined. */
    font-weight: var(--type-subtitle-emphasis-weight);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    cursor: pointer;
  }

  /* The bubble's tail (the speech-bubble point) from Figma is deliberately
     omitted: it is drawn at a fixed percentage inset of a fixed-width
     bubble, which does not survive the bubble being repositioned by the
     script below. Approximating it would drift out of alignment, so it is
     left off as a known visual difference rather than faked. */
  .definition-tip {
    /* A <span>, not a <div>: the trigger sits inline in running prose (e.g.
       CaseStudyIntro's lead paragraph), and a <div popover> there would
       close the parent <p> per the HTML parsing spec, ejecting the rest of
       the sentence out of its styled wrapper. `popover` is a global
       attribute and works on any element, so a <span> keeps this safe to
       drop into flowing text anywhere.

       Do NOT set `display` here: an author `display` beats the browser's
       `[popover]:not(:popover-open) { display: none }`, leaving a closed
       popover visible in the flow. An open popover is position: fixed, which
       already blockifies the span. */
    inline-size: min(28.9375rem, calc(100vw - 2rem)); /* 463px */
    padding: var(--space-16);
    border: 0;
    border-radius: var(--radius-card);
    background-color: var(--color-white);
    color: var(--color-purple);
    filter: var(--shadow-definition-tip);
  }

  .definition-tip__term,
  .definition-tip__body {
    display: block;
  }

  .definition-tip__term {
    margin-block-end: var(--space-8);
    font-weight: var(--type-subtitle-emphasis-weight);
  }
</style>

<script>
  // Reason for client JS (invariant 3). Opening on click or tap, closing on
  // Escape or a click outside, and focus handling are native to the
  // Popover API; the trigger's popovertargetaction="show" makes a click
  // only open it. The script adds two things:
  //  1. Position: popovers render in the top layer, outside the flow, so
  //     CSS can't place the bubble under its trigger. Without JS it opens
  //     centred in the viewport.
  //  2. D-042: open on hover (mouse and pen) and on keyboard focus. It stays
  //     open while the pointer is over the trigger or the bubble, with a
  //     short grace period for crossing the gap between them (WCAG 1.4.13),
  //     and closes on leaving or blur.
  const GRACE_MS = 200;

  for (const trigger of document.querySelectorAll<HTMLButtonElement>(
    '.definition-trigger',
  )) {
    const tip = document.getElementById(trigger.getAttribute('popovertarget')!);
    if (!tip) continue;

    tip.addEventListener('beforetoggle', (event) => {
      if ((event as ToggleEvent).newState !== 'open') return;
      const rect = trigger.getBoundingClientRect();
      tip.style.position = 'fixed';
      tip.style.margin = '0';
      tip.style.insetBlockStart = `${rect.bottom + 8}px`;
      tip.style.insetInlineStart = `${rect.left}px`;
    });

    let hovering = false;
    let closeTimer = 0;
    const isOpen = () => tip.matches(':popover-open');
    const show = () => {
      clearTimeout(closeTimer);
      if (!isOpen()) tip.showPopover();
    };
    const hide = () => {
      if (isOpen()) tip.hidePopover();
    };
    // Keyboard focus keeps it open; a mouse click's focus doesn't.
    const closeSoon = () => {
      clearTimeout(closeTimer);
      closeTimer = window.setTimeout(() => {
        if (!hovering && !trigger.matches(':focus-visible')) hide();
      }, GRACE_MS);
    };

    for (const el of [trigger, tip]) {
      el.addEventListener('pointerenter', (event) => {
        if (event.pointerType === 'touch') return;
        hovering = true;
        show();
      });
      el.addEventListener('pointerleave', (event) => {
        if (event.pointerType === 'touch') return;
        hovering = false;
        closeSoon();
      });
    }
    trigger.addEventListener('focus', show);
    trigger.addEventListener('blur', () => {
      if (!hovering) hide();
    });
  }
</script>
