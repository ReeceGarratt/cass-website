---
import { getCollection } from 'astro:content';
import CaseStudyCard from './CaseStudyCard.astro';

interface Props {
  currentId: string;
  /** Full-bleed Purple band (Q-046: MiX Telematics only). */
  band?: boolean;
}

const { currentId, band = false } = Astro.props;

const others = (await getCollection('caseStudies'))
  .filter((entry) => entry.id !== currentId)
  .sort((a, b) => a.data.order - b.data.order);
---

<section
  class:list={['read-more', band && 'read-more--band u-bleed band band--purple']}
  aria-labelledby="read-more-heading"
>
  <div class="read-more__inner">
    <h2 class="read-more__heading type-title-1" id="read-more-heading">
      Other case studies
    </h2>
    <ul class="read-more__list" role="list">
      {others.map((entry) => (
        <li class="read-more__item">
          <CaseStudyCard caseStudy={entry} showClient headingLevel={3} />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* 99:2461: heading 262px, 60px, three 448px cards 16px apart = 1698px,
     inside the 1700px content track at 1920. Rounding the 60px up to
     --space-64 made the row 1702px, which forced the page 2px wider than
     the viewport. */
  .read-more__inner {
    display: flex;
    gap: var(--space-read-more-gap);
    align-items: center;
  }

  /* Q-046, MiX Telematics only (92:2089): the band runs to the bottom of
     the page, so it cancels the layout's 80px bottom padding, and the
     light heading reads on Purple. */
  .read-more--band {
    margin-block-end: calc(-1 * var(--space-80));
  }

  .read-more--band .read-more__inner {
    max-inline-size: calc(var(--page-max-width) - 2 * var(--space-gutter));
    margin-inline: auto;
  }

  .read-more--band .read-more__heading {
    color: var(--color-off-white);
  }

  .read-more__heading {
    flex: none;
    inline-size: 16.375rem; /* 262px */
    color: var(--color-purple);
    text-align: end;
  }

  .read-more__list {
    display: flex;
    min-inline-size: 0;
    gap: var(--space-16);
    align-items: stretch;
    padding: 0;
    list-style: none;
  }

  /* 448px at full width, but allowed to shrink: a fixed width made the
     row's min-content wider than any viewport below ~1920px, giving the
     whole page a horizontal scrollbar. */
  .read-more__item {
    display: flex;
    flex: 0 1 28rem; /* 448px */
    min-inline-size: 0;
  }
</style>
