---
interface Props {
  eyebrow?: string;
  title: string;
  align?: 'start' | 'end';
  id?: string;
  level?: 2 | 3;
}

const { eyebrow, title, align = 'end', id, level = 2 } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
---

<div class:list={['section-heading', `section-heading--${align}`]}>
  <Heading class="section-heading__title type-title-2" id={id}>
    {eyebrow && (
      <span class="section-heading__eyebrow type-handwritten">{eyebrow}</span>
    )}
    {title}
  </Heading>
  {Astro.slots.has('default') && (
    <p class="section-heading__standfirst type-subtitle">
      <slot />
    </p>
  )}
</div>

<style>
  .section-heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-headings-body);
  }

  .section-heading--end {
    align-items: flex-end;
    text-align: end;
  }

  .section-heading__title {
    color: var(--color-red);
    text-transform: lowercase;
  }

  .section-heading__eyebrow {
    display: block;
    color: var(--color-purple);
    text-transform: lowercase;
  }
</style>
