---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../utils/base-path';
import CircleArrow from './CircleArrow.astro';
import Pill from './Pill.astro';
import CornerTopRight from '../assets/corner-top-right.svg';
import CornerBottomLeft from '../assets/corner-bottom-left.svg';

interface Props {
  caseStudy: CollectionEntry<'caseStudies'>;
  showClient?: boolean;
  headingLevel?: 2 | 3;
  /** Compact: the case study Read More rows (Figma Compact Card 4:123).
   * Detailed: the home page (Detailed Card 129:3554), with the client pill
   * and a thumbnail. */
  size?: 'compact' | 'detailed';
  /** The thumbnail. Detailed only. */
  image?: ImageMetadata;
}

const {
  caseStudy,
  showClient = false,
  headingLevel = 2,
  size = 'compact',
  image,
} = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const { title, client, skills, summary, cardTitleBreak } = caseStudy.data;
const detailed = size === 'detailed';
// D-057: detailed cards break the title where Figma does.
const titleRest =
  detailed && cardTitleBreak
    ? title.slice(cardTitleBreak.length).trim()
    : undefined;
---

<article class:list={['card', { 'card--detailed': detailed }]}>
  {(showClient || detailed) && <Pill class="card__client">{client}</Pill>}
  <Heading class="card__title">
    <a class="card__link" href={withBase(`/work/${caseStudy.id}`)}>
      {titleRest ? cardTitleBreak : title}
      {titleRest && <br />}
      {titleRest}
    </a>
  </Heading>
  <ul class="card__skills" role="list">
    {skills.map((skill) => (
      <li class="card__skill">{skill}</li>
    ))}
  </ul>
  {detailed && image && (
    <div class="card__thumbnail">
      <Image
        class="card__thumbnail-image"
        src={image}
        alt=""
        widths={[341, 682]}
        sizes="341px"
      />
    </div>
  )}
  <p class="card__summary">{summary}</p>
  <CircleArrow class="card__arrow" />
  {!detailed && (
    <>
      <span class="card__corner card__corner--top-right" aria-hidden="true">
        <CornerTopRight />
      </span>
      <span class="card__corner card__corner--bottom-left" aria-hidden="true">
        <CornerBottomLeft />
      </span>
    </>
  )}
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-card-stack);
    padding: var(--space-card-padding);
    border-radius: var(--radius-card);
    background-color: var(--color-white);
    /* Flat: no shadow (style guide 306:1542, D-037) */
  }

  /* Pill and CircleArrow are child components: a scoped .card__client
     selector never matches their root element (Astro scopes only this
     template's own elements), which left the pills full width and the
     arrows on the left. Reach them through :global(). */
  .card > :global(.card__client) {
    align-self: start;
  }

  .card__title {
    max-inline-size: var(--size-card-title-width);
    block-size: var(--size-card-title-height);
    color: var(--color-purple);
    font-size: var(--type-card-title-size);
    font-weight: var(--type-card-title-weight);
    line-height: var(--type-card-title-line-height);
    letter-spacing: var(--type-card-title-letter-spacing);
  }

  .card__link {
    color: inherit;
    text-decoration: none;
  }

  /* Stretch the title link over the whole card */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: var(--radius-card);
  }

  .card__link:focus-visible {
    outline: none;
    box-shadow: none;
  }

  .card:has(.card__link:focus-visible) {
    outline: var(--focus-ring-width) solid var(--focus-ring-inner);
    outline-offset: var(--focus-ring-width);
  }

  .card__skills {
    display: flex;
    flex-wrap: wrap;
    padding: 0;
    color: var(--color-purple);
    font-size: var(--type-caption-size);
    font-weight: var(--type-caption-weight);
    line-height: var(--type-caption-line-height);
    letter-spacing: var(--type-caption-letter-spacing);
    list-style: none;
  }

  .card__skill:not(:last-child)::after {
    content: '|' / '';
    margin-inline: var(--space-skill-separator);
  }

  .card__summary {
    min-block-size: var(--size-card-summary-min-height);
    color: var(--color-grey);
  }

  .card > :global(.card__arrow) {
    align-self: flex-end;
    margin-block-start: auto;
  }

  .card__corner :global(svg) {
    inline-size: 100%;
    block-size: 100%;
  }

  .card__corner {
    position: absolute;
    opacity: 0;
    color: var(--color-white);
  }

  .card__corner--top-right {
    inset-block-start: var(--card-corner-top-right-top);
    inset-inline-end: var(--card-corner-top-right-right);
    inline-size: var(--card-corner-top-right-width);
    block-size: var(--card-corner-top-right-height);
  }

  .card__corner--bottom-left {
    inset-block-end: var(--card-corner-bottom-left-bottom);
    inset-inline-start: var(--card-corner-bottom-left-left);
    inline-size: var(--card-corner-bottom-left-width);
    block-size: var(--card-corner-bottom-left-height);
    rotate: 180deg;
  }

  /* Fade into and out of the hover state. Opacity, not display, so the
     arrows and corners can crossfade */
  .card,
  .card__title,
  .card__skills,
  .card__summary,
  .card__corner {
    transition-property: background-color, color, opacity;
    transition-duration: var(--duration-hover);
    transition-timing-function: var(--ease-hover);
  }

  /* Hover state (Figma "Variant2"), also for keyboard focus */
  .card:is(:hover, :focus-within) {
    background-color: var(--color-purple);
  }

  .card:is(:hover, :focus-within) .card__title,
  .card:is(:hover, :focus-within) .card__summary {
    color: var(--color-off-white);
  }

  .card:is(:hover, :focus-within) .card__skills {
    color: var(--color-white);
  }

  .card:is(:hover, :focus-within) :global(.circle-arrow__icon--default) {
    opacity: 0;
  }

  .card:is(:hover, :focus-within) :global(.circle-arrow__icon--hover) {
    opacity: 1;
  }

  .card:is(:hover, :focus-within) .card__corner {
    opacity: 1;
  }

  /* Detailed (Figma Detailed Card 129:3554), on the home page. */
  .card--detailed {
    gap: var(--space-24);
    min-block-size: var(--size-card-detailed-min-height);
    padding: var(--space-32);
  }

  .card--detailed .card__title {
    max-inline-size: none;
    block-size: auto;
    min-block-size: var(--size-card-detailed-title-height);
    color: var(--color-black);
    text-transform: lowercase;
  }

  .card--detailed .card__summary {
    min-block-size: 0;
  }

  .card__thumbnail {
    overflow: hidden;
    aspect-ratio: var(--ratio-card-thumbnail);
    border: 1px solid var(--color-light-grey);
    border-radius: var(--radius-card);
  }

  .card__thumbnail-image {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .card--detailed > :global(.card__client) {
    transition-property: background-color, color;
    transition-duration: var(--duration-hover);
    transition-timing-function: var(--ease-hover);
  }

  /* Its hover (Variant2) differs from the compact card's: White title and
     summary, Light purple skills and pill, and no corner strokes. */
  .card--detailed:is(:hover, :focus-within) .card__title,
  .card--detailed:is(:hover, :focus-within) .card__summary {
    color: var(--color-white);
  }

  .card--detailed:is(:hover, :focus-within) .card__skills {
    color: var(--color-light-purple);
  }

  .card--detailed:is(:hover, :focus-within) > :global(.card__client) {
    background-color: var(--color-light-purple);
    color: var(--color-purple);
  }
</style>
