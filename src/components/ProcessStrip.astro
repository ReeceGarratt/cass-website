---
interface Props {
  // Each label's width is the fixed width Figma gives that text node, so
  // long labels wrap as designed; without it a label can't shrink below its
  // own min-content and the six-step row overflows narrower viewports.
  // Measured per case study rather than looked up by label text: the same
  // label differs between frames ("user research" is 129px in CS1's 67:334
  // and 126px in CS2's 91:701). Pass a --size-process-step-* token (in em,
  // so it scales with the strip's type).
  steps: { label: string; width: `var(--size-process-step-${string})` }[];
  class?: string;
}

const { steps, class: className } = Astro.props;
---

<div class:list={['process-strip', className]}>
  <ol class="process-strip__list" role="list">
    {steps.map(({ label, width }) => (
      <li class="process-strip__step">
        <span
          class="process-strip__label type-h1"
          style={`inline-size: ${width}`}
        >
          {label}
        </span>
      </li>
    ))}
  </ol>
</div>

<style>
  /* Band background, padding and step type from the fetched Process
     section (67:334): Purple full-bleed band, py-40px, Inter Bold 30px
     white lowercase labels (the site's existing .type-h1 — the same
     30/0.92/700 style already used for card titles). */
  .process-strip {
    /* A size container so the type below is fitted to the band's own
       width; vw would include a classic scrollbar and overshoot. */
    container-type: inline-size;
    background-color: var(--color-purple);
    padding-block: var(--space-40);
  }

  /* Figma's size (30px) by default. When the row no longer fits inside
     the gutters, the type (and with it every em-sized label, arrow and gap)
     scales down to fit, and below the minimum size the row wraps instead,
     taking more height rather than overflowing. */
  .process-strip__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    /* gap-32px in the fetched section, between every item (label or arrow)
       in the row; the same between wrapped rows */
    gap: var(--space-process-step-gap);
    padding: 0 var(--space-gutter);
    margin: 0;
    list-style: none;
    font-size: clamp(
      var(--type-process-min-size),
      (100cqi - 2 * var(--space-gutter)) / var(--size-process-row),
      var(--type-card-title-size)
    );
  }

  .process-strip__step {
    display: flex;
    align-items: center;
    gap: var(--space-process-step-gap);
  }

  .process-strip__label {
    /* The list's fitted size, over .type-h1's fixed one. */
    font-size: inherit;
    /* No shrinking below the measured width — the whole point is to force
       the same wraps Figma has, not let flex compress it back down. */
    flex-shrink: 0;
    /* Safety net, not a measured value: caps a label passed an oversized
       width, so it wraps instead of forcing the row to min-content width.
       Larger than every measured width (the widest is 210px), so real
       labels are sized by their own inline-size and never reach it. */
    max-inline-size: var(--size-process-step-max);
    color: var(--color-white);
    text-transform: lowercase;
    /* Figma's label text nodes carry no centring; left as default
       (start-aligned), which also reads correctly for the single-line
       "design" label. */
  }

  /* Decorative arrow between steps, an image so it never enters the
     accessibility tree. arrow-01.svg is the composed Arrow_01 symbol
     (129:3488) exported whole: a near-straight line with its head, pointing
     right. Box size is the Arrow_01 instance bounding box from the Process
     section outline (67:334): 41.83 x 27.33px.

     Colour: the arrows render White on the Purple band (fetched
     screenshot), but url()-referenced SVGs don't take `currentColor` from
     the embedding page, so the stroke resolves to black. invert(1) flips
     that black to White (alpha is preserved); brightness(0) first keeps it
     correct whatever colour the source stroke is. */
  .process-strip__step:not(:last-child)::after {
    content: '';
    display: block;
    inline-size: var(--size-process-arrow-width);
    block-size: var(--size-process-arrow-height);
    background: url('../assets/arrow-01.svg') center / contain no-repeat;
    filter: brightness(0) invert(1);
  }
</style>
