---
import { Font } from 'astro:assets';
import SiteNav from '../components/SiteNav.astro';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
  /**
   * Skip <main>'s max width and inline gutter padding. For layouts that lay
   * out their own full-width grid (CaseStudyLayout's .case-study owns its
   * gutter and content cap), where either would stop `u-bleed` reaching the
   * viewport edge.
   */
  fullBleed?: boolean;
}

const { title, fullBleed = false } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <Font cssVariable="--font-inter" preload />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <SiteNav currentPath={Astro.url.pathname} />
    </header>
    <main
      id="main"
      class:list={['site-main', { 'site-main--contained': !fullBleed }]}
      tabindex="-1"
    >
      <slot />
    </main>
  </body>
</html>

<style>
  .site-header {
    background-color: var(--color-purple);
  }

  .site-main--contained {
    max-inline-size: var(--page-max-width);
    margin-inline: auto;
    padding-inline: var(--space-gutter);
  }

  .site-main:focus {
    outline: none;
    box-shadow: none;
  }
</style>
