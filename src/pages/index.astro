---
import type { ImageMetadata } from 'astro';
import { Font } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import ClientStrip from '../components/ClientStrip.astro';
import EmailPill from '../components/EmailPill.astro';
import Flower from '../assets/flower.svg';
import OpenToWork from '../assets/landing/open-to-work.svg';
import absaCard from '../assets/landing/card-streamlining-scoring.png';
import standardBankCard from '../assets/landing/card-consolidating-import-collections.png';
import mixCard from '../assets/landing/card-sales-workflow-research.png';
import transearchCard from '../assets/landing/card-designing-an-interactive-workbook.png';

// D-056: four detailed cards, the first four by `order`. Q-019 stays
// open for what happens at five or more.
const FEATURED_COUNT = 4;

// Each card's thumbnail, cropped as Figma shows it (267:1907). A featured
// case study without one fails the build, so a renamed id can't ship a
// card with no image.
const cardImages: Record<string, ImageMetadata> = {
  'streamlining-scoring': absaCard,
  'consolidating-import-collections': standardBankCard,
  'sales-workflow-research': mixCard,
  'designing-an-interactive-workbook': transearchCard,
};

const featured = (await getCollection('caseStudies'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, FEATURED_COUNT)
  .map((caseStudy) => {
    const image = cardImages[caseStudy.id];
    if (!image)
      throw new Error(
        `No landing card image for case study "${caseStudy.id}". Add src/assets/landing/card-${caseStudy.id}.png and an entry in cardImages in src/pages/index.astro.`,
      );
    return { caseStudy, image };
  });

// 05 · About & design approach (282:921). Lines as Figma breaks them; the
// layer names in Figma are stale, so this is built from the text.
const principles = [
  {
    title: ['Accessibility is for', 'everyone'],
    body: 'I strongly advocate for accessible design because it improves the experience for all users, not just a limited group. Accessible products also help users in daily scenarios, such as a parent completing a bank transfer while juggling a busy toddler.',
  },
  {
    title: ['Collaboration is', 'a must'],
    body: 'From the outset, I foster collaboration among developers and key stakeholders to create designs that not only align with business objectives but are also technically feasible. This approach ensures that our solutions are both innovative and practical.',
  },
  {
    title: ['good design as a', 'competitive edge'],
    body: 'Investing in quality design is essential for businesses to stand out in today’s market. Users prioritize functional products that fulfill their needs over flashy corporate histories or pretty UI’s.',
  },
];
---

<BaseLayout title="cassandra garratt" navVariant="white" fullBleed>
  <Font slot="head" cssVariable="--font-la-belle-aurore" preload />
  <div class="landing">
    <div class="hero">
      <div class="hero__headline">
        <p class="hero__status">
          <span class="hero__status-text" aria-hidden="true">
            <OpenToWork />
          </span>
          <span class="visually-hidden">Open to work</span>
        </p>
        <span class="hero__flower" aria-hidden="true">
          <Flower />
        </span>
        <h1 class="hero__title type-title">
          <span class="hero__line hero__line--first">effective &amp;</span>{' '}
          <span class="hero__line">empathetic</span>{' '}
          <span class="hero__line">design</span>
        </h1>
        <span class="hero__pill" aria-hidden="true"></span>
      </div>
      <p class="hero__intro type-subtitle">
        I am a proactive <strong>ux/ui designer</strong> with a passion for{' '}
        <strong>inclusive technology</strong> and <strong>user advocacy</strong>
        .
      </p>
      <EmailPill />
    </div>
    <ClientStrip />
    <section class="work" aria-labelledby="work-heading">
      <h2 class="work__heading type-title-1" id="work-heading">
        some of my&nbsp;
        <span class="work__favourite type-handwritten">favourite</span>
        <span class="work__caret type-handwritten" aria-hidden="true">
          <span>&lt;</span>
        </span>{' '}
        projects
      </h2>
      <ul class="work__cards" role="list">
        {featured.map(({ caseStudy, image }) => (
          <li class="work__card">
            <CaseStudyCard
              caseStudy={caseStudy}
              size="detailed"
              image={image}
              headingLevel={3}
            />
          </li>
        ))}
      </ul>
    </section>
    <section class="about" aria-labelledby="about-heading">
      <div class="about__inner">
        <div class="about__intro">
          <h2 class="about__heading type-title-2" id="about-heading">
            thoughtful design with
            <br />
            Meaningful outcomes
          </h2>
          <p class="about__body type-subtitle">
            Good design makes room for people. My design practice is centred on
            inclusive technology, collaborative workflows and leveraging good
            design as a competitive edge.
          </p>
        </div>
        <ul class="about__principles" role="list">
          {principles.map(({ title, body }) => (
            <li class="about__principle">
              <h3 class="about__principle-title type-h1">
                {title[0]}
                <br />
                {title[1]}
              </h3>
              <p class="about__principle-body">{body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
    <section class="contact" aria-labelledby="contact-heading">
      <h2 class="contact__heading type-title-1" id="contact-heading">
        let’s make something
        <br />
        meaningful.
      </h2>
      <EmailPill />
      <span class="contact__flower" aria-hidden="true">
        <Flower />
      </span>
    </section>
  </div>
</BaseLayout>

<style>
  /* 267:1855: the root sections sit 160px apart. Full bleed (BaseLayout
     fullBleed), so the client strip and the about band reach the edges;
     the other sections keep the gutter themselves. */
  .landing {
    display: flex;
    flex-direction: column;
    gap: var(--space-160);
    padding-block-end: var(--space-landing-end);
  }

  /* Hero (267:1857): 80px below the nav, then the headline, the intro and
     the email pill, 56px apart. Content-box, so the 800px measure excludes
     the gutter padding and the hero's left edge lands on x=560. */
  .hero {
    box-sizing: content-box;
    display: flex;
    flex-direction: column;
    gap: var(--space-56);
    align-items: flex-start;
    max-inline-size: var(--size-hero-width);
    margin-inline: auto;
    padding-block-start: var(--space-80);
    padding-inline: var(--space-gutter);
  }

  /* The 383px headline frame (267:1858). Its font size is the headline's,
     so the accents' em tokens scale with it. */
  .hero__headline {
    position: relative;
    align-self: stretch;
    block-size: var(--hero-headline-height);
    margin-inline-start: var(--hero-headline-nudge);
    font-size: var(--type-title-size);
  }

  .hero__title {
    padding-block-start: var(--hero-headline-top);
    color: var(--color-black);
    white-space: nowrap;
  }

  .hero__line {
    display: block;
  }

  .hero__line--first {
    text-indent: var(--hero-line-1-indent);
  }

  .hero__flower,
  .hero__status,
  .hero__pill {
    position: absolute;
  }

  .hero__flower {
    inset-block-start: var(--hero-flower-top);
    inset-inline-start: var(--hero-flower-left);
    inline-size: var(--hero-flower-size);
    block-size: var(--hero-flower-size);
    color: var(--color-red);
  }

  /* Above the flower, as in Figma's layer order */
  .hero__status {
    z-index: 1;
    inset-block-start: var(--hero-status-top);
    inset-inline-start: var(--hero-status-left);
    inline-size: var(--hero-status-width);
    block-size: var(--hero-status-height);
    color: var(--color-status);
  }

  .hero__flower :global(svg),
  .hero__status-text :global(svg) {
    inline-size: 100%;
    block-size: 100%;
  }

  .hero__pill {
    inset-block-start: var(--hero-pill-top);
    inset-inline-start: var(--hero-pill-left);
    inline-size: var(--hero-pill-width);
    block-size: var(--hero-pill-height);
    border-radius: var(--radius-pill);
    background-color: var(--color-purple);
  }

  .hero__intro {
    max-inline-size: var(--size-hero-intro-width);
    color: var(--color-purple);
  }

  .hero__intro strong {
    font-weight: var(--type-subtitle-emphasis-weight);
  }

  /* 04 · Selected work (267:1902): heading, 56px, four cards 24px apart. */
  .work {
    display: flex;
    flex-direction: column;
    gap: var(--space-56);
    align-items: center;
    padding-inline: var(--space-gutter);
  }

  .work__heading {
    position: relative;
    padding-block: var(--space-work-heading-top)
      var(--space-work-heading-bottom);
    color: var(--color-purple);
    text-align: center;
  }

  .work__favourite,
  .work__caret {
    position: absolute;
    color: var(--color-red);
  }

  .work__favourite {
    inset-block-start: 0;
    inset-inline-start: var(--work-favourite-left);
    text-transform: lowercase;
    white-space: nowrap;
  }

  .work__caret {
    display: grid;
    place-items: center;
    inset-block-start: var(--work-caret-top);
    inset-inline-start: var(--work-caret-left);
    inline-size: var(--size-work-caret-width);
    block-size: var(--size-work-caret-height);
  }

  .work__caret > span {
    rotate: var(--work-caret-rotate);
  }

  /* Narrow screens (not designed): the heading wraps, so the accents can't
     sit over its gap. "favourite" joins the line instead. */
  @media (max-width: 37.5rem) {
    .work__favourite {
      position: static;
    }

    .work__caret {
      display: none;
    }
  }

  /* Equal rows; as many 405px columns as fit, centred (four at 1920). */
  .work__cards {
    display: grid;
    grid-template-columns: repeat(
      auto-fill,
      minmax(0, var(--size-card-detailed-width))
    );
    grid-auto-rows: 1fr;
    gap: var(--space-24);
    justify-content: center;
    inline-size: 100%;
    max-inline-size: var(--size-landing-measure);
    padding: 0;
    list-style: none;
  }

  .work__card {
    display: grid;
  }

  /* 05 · About & design approach (282:917): a full-bleed Light purple
     band. Its content is the 1692px measure, so 114px insets at 1920. */
  .about {
    padding-block: var(--space-96);
    padding-inline: var(--space-gutter);
    background-color: var(--color-light-purple);
    color: var(--color-purple);
  }

  .about__inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-about-columns);
    max-inline-size: var(--size-landing-measure);
    margin-inline: auto;
  }

  .about__intro {
    display: flex;
    flex: 0 1 var(--size-about-intro-width);
    flex-direction: column;
    gap: var(--space-24);
  }

  .about__heading,
  .about__principle-title {
    text-transform: lowercase;
  }

  .about__heading {
    min-block-size: var(--size-about-heading-height);
  }

  .about__body {
    max-inline-size: var(--size-about-body-width);
  }

  .about__principles {
    display: flex;
    flex: 1 1 var(--size-about-principles-min);
    flex-direction: column;
    gap: var(--space-principles);
    padding: 0;
    list-style: none;
  }

  .about__principle {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-16) var(--space-40);
  }

  .about__principle:not(:last-child) {
    padding-block-end: var(--space-principle-divider);
    border-block-end: 1px solid var(--color-divider-purple);
  }

  .about__principle-title {
    flex: 0 0 var(--size-principle-title-width);
  }

  .about__principle-body {
    flex: 1 1 20rem; /* 320px; not designed: when the body drops under its title */
    max-inline-size: var(--size-principle-body-width);
  }

  .about__principle:nth-child(2) .about__principle-body {
    max-inline-size: var(--size-principle-body-width-2);
  }

  .about__principle:nth-child(3) .about__principle-body {
    max-inline-size: var(--size-principle-body-width-3);
  }

  /* 06 · Contact (267:1938): heading, email pill and Flower, 32px apart. */
  .contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
    align-items: center;
    padding-inline: var(--space-gutter);
    text-align: center;
  }

  .contact__heading {
    color: var(--color-purple);
  }

  .contact__flower {
    inline-size: var(--size-contact-flower);
    block-size: var(--size-contact-flower);
    color: var(--color-red);
  }

  .contact__flower :global(svg) {
    inline-size: 100%;
    block-size: 100%;
  }
</style>
