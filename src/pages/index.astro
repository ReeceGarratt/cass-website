---
import { Font } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ClientStrip from '../components/ClientStrip.astro';
import EmailPill from '../components/EmailPill.astro';
import Flower from '../assets/flower.svg';
import OpenToWork from '../assets/landing/open-to-work.svg';
---

<BaseLayout title="cassandra garratt" navVariant="white" fullBleed>
  <Font slot="head" cssVariable="--font-la-belle-aurore" preload />
  <div class="landing">
    <div class="hero">
      <div class="hero__headline">
        <p class="hero__status">
          <span class="hero__status-text" aria-hidden="true">
            <OpenToWork />
          </span>
          <span class="visually-hidden">Open to work</span>
        </p>
        <span class="hero__flower" aria-hidden="true">
          <Flower />
        </span>
        <h1 class="hero__title type-title">
          <span class="hero__line hero__line--first">effective &amp;</span>
          <span class="hero__line">empathetic</span>
          <span class="hero__line">design</span>
        </h1>
        <span class="hero__pill" aria-hidden="true"></span>
      </div>
      <p class="hero__intro type-subtitle">
        I am a proactive <strong>ux/ui designer</strong> with a passion for{' '}
        <strong>inclusive technology</strong> and <strong>user advocacy</strong>
        .
      </p>
      <EmailPill />
    </div>
    <ClientStrip />
  </div>
</BaseLayout>

<style>
  /* 267:1855: the root sections sit 160px apart. Full bleed (BaseLayout
     fullBleed), so the client strip and the about band reach the edges;
     the other sections keep the gutter themselves. */
  .landing {
    display: flex;
    flex-direction: column;
    gap: var(--space-160);
    padding-block-end: var(--space-landing-end);
  }

  /* Hero (267:1857): 80px below the nav, then the headline, the intro and
     the email pill, 56px apart. Content-box, so the 800px measure excludes
     the gutter padding and the hero's left edge lands on x=560. */
  .hero {
    box-sizing: content-box;
    display: flex;
    flex-direction: column;
    gap: var(--space-56);
    align-items: flex-start;
    max-inline-size: var(--size-hero-width);
    margin-inline: auto;
    padding-block-start: var(--space-80);
    padding-inline: var(--space-gutter);
  }

  /* The 383px headline frame (267:1858). Its font size is the headline's,
     so the accents' em tokens scale with it. */
  .hero__headline {
    position: relative;
    align-self: stretch;
    block-size: var(--hero-headline-height);
    margin-inline-start: var(--hero-headline-nudge);
    font-size: var(--type-title-size);
  }

  .hero__title {
    padding-block-start: var(--hero-headline-top);
    color: var(--color-black);
    white-space: nowrap;
  }

  .hero__line {
    display: block;
  }

  .hero__line--first {
    text-indent: var(--hero-line-1-indent);
  }

  .hero__flower,
  .hero__status,
  .hero__pill {
    position: absolute;
  }

  .hero__flower {
    inset-block-start: var(--hero-flower-top);
    inset-inline-start: var(--hero-flower-left);
    inline-size: var(--hero-flower-size);
    block-size: var(--hero-flower-size);
    color: var(--color-red);
  }

  /* Above the flower, as in Figma's layer order */
  .hero__status {
    z-index: 1;
    inset-block-start: var(--hero-status-top);
    inset-inline-start: var(--hero-status-left);
    inline-size: var(--hero-status-width);
    block-size: var(--hero-status-height);
    color: var(--color-status);
  }

  .hero__flower :global(svg),
  .hero__status-text :global(svg) {
    inline-size: 100%;
    block-size: 100%;
  }

  .hero__pill {
    inset-block-start: var(--hero-pill-top);
    inset-inline-start: var(--hero-pill-left);
    inline-size: var(--hero-pill-width);
    block-size: var(--hero-pill-height);
    border-radius: var(--radius-pill);
    background-color: var(--color-purple);
  }

  .hero__intro {
    max-inline-size: var(--size-hero-intro-width);
    color: var(--color-purple);
  }

  .hero__intro strong {
    font-weight: var(--type-subtitle-emphasis-weight);
  }
</style>
